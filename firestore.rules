rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rules for repairs collection
    match /repairs/{repairId} {
      allow read, write: if true;
    }

    // Clients registered from the Android app
    match /clientes/{clientId} {
      allow read, write: if true;
    }

    // Technical chat between client and workshop
    match /chats/{phoneKey}/messages/{messageId} {
      allow read, write: if true;
    }
  }
}
