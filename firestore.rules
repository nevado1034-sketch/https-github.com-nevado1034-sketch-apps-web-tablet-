rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedLocal(localKey) {
      return localKey in ['lince_arenales', 'surco', 'san_borja', 'lince_leal'];
    }

    // ══════════════════════════════════════════════════════════════════════
    // REPAIRS: la tablet escribe sin autenticación (flujo tablet→Firestore)
    // ══════════════════════════════════════════════════════════════════════
    match /repairs/{repairId} {
      allow read, write: if true;
    }

    // ══════════════════════════════════════════════════════════════════════
    // CLIENTES CANÓNICOS (doc id = DNI): fuente única por persona
    // - READ: libre (necesario para búsqueda cross-sede por DNI)
    // - CREATE/UPDATE: libre (tablet + express lo escribe sin auth)
    // - DELETE: BLOQUEADO — el historial de clientes es inmutable
    // ══════════════════════════════════════════════════════════════════════
    match /clientes/{clientId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════
    // CLIENTES POR LOCAL (subcolección por sede): espejo privado de cada local
    // - READ/WRITE: solo el local autorizado
    // - DELETE: permitido para limpieza de duplicados/test desde ese local
    // ══════════════════════════════════════════════════════════════════════
    match /clientes/{localKey}/clientes/{clientId} {
      allow read: if isAllowedLocal(localKey);
      allow create, update: if isAllowedLocal(localKey)
        && request.resource.data.size() <= 20
        && request.resource.data.name is string
        && request.resource.data.dni is string
        && request.resource.data.sedeKey is string;
      allow delete: if isAllowedLocal(localKey);
    }

    // ══════════════════════════════════════════════════════════════════════
    // RECIBOS EXPRESS POR LOCAL
    // ══════════════════════════════════════════════════════════════════════
    match /recibos_express/{localKey}/recibos/{correlative} {
      allow read: if isAllowedLocal(localKey);
      allow write: if isAllowedLocal(localKey)
        && request.resource.data.correlative == correlative
        && request.resource.data.total is number;
      allow delete: if isAllowedLocal(localKey);
    }

    match /recibos_express/{localKey}/meta/{metaId} {
      allow read, write: if isAllowedLocal(localKey)
        && request.resource.data.count is number;
    }

    // ══════════════════════════════════════════════════════════════════════
    // CHAT TÉCNICO: el cliente usa sin autenticación (WhatsApp flow)
    // ══════════════════════════════════════════════════════════════════════
    match /chats/{phoneKey}/messages/{messageId} {
      allow read, write: if true;
    }

    // ══════════════════════════════════════════════════════════════════════
    // ENTIDADES AUXILIARES: activos, órdenes, contadores, config
    // Permisivo por ahora; restringir cuando se implemente auth completa
    // ══════════════════════════════════════════════════════════════════════
    match /activos/{assetId} {
      allow read, write: if true;
    }

    match /ordenes/{ordenId} {
      allow read, write: if true;
    }

    match /counters/{counterId} {
      allow read, write: if true;
    }

    match /config/{docId} {
      allow read, write: if true;
    }
  }
}
