rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedLocal(localKey) {
      return localKey in ['lince_arenales', 'surco', 'san_borja', 'lince_leal'];
    }

    // Repairs collection (tablet + server)
    match /repairs/{repairId} {
      allow read, write: if true;
    }

    // Canonical clients (Android app + espejo). Se mantiene permisivo por compatibilidad con Android.
    match /clientes/{clientId} {
      allow read, write: if true;
    }

    // Registro de clientes por local: estructura validada
    match /clientes/{localKey}/clientes/{clientId} {
      allow read: if isAllowedLocal(localKey);
      allow write: if isAllowedLocal(localKey)
        && request.resource.data.size() <= 20
        && request.resource.data.name is string
        && request.resource.data.dni is string
        && request.resource.data.sedeKey is string;
    }

    // Recibos Express por local
    match /recibos_express/{localKey}/recibos/{correlative} {
      allow read: if isAllowedLocal(localKey);
      allow write: if isAllowedLocal(localKey)
        && request.resource.data.correlative == correlative
        && request.resource.data.total is number;
    }

    match /recibos_express/{localKey}/meta/{metaId} {
      allow read, write: if isAllowedLocal(localKey)
        && request.resource.data.count is number;
    }

    // Chat técnico entre cliente y taller
    match /chats/{phoneKey}/messages/{messageId} {
      allow read, write: if true;
    }
  }
}
